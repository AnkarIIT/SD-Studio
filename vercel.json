{
  "version": 2,
  "buildCommand": "prisma generate && vite build && node scripts/vercel-build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": ["server/**", "src/constants.js"]
    }
  }
}
