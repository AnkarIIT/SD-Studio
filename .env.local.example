# ============================================
# FRONTEND (Vite — http://localhost:3000)
# ============================================
VITE_NOTIFICATION_API_URL=

# ============================================
# SERVER (Express — port 5001)
# ============================================
NOTIFICATION_PORT=5001

# ============================================
# DATABASE (Neon PostgreSQL)
# Runtime/serverless: use the POOLED host (add -pooler after the endpoint id)
# and ?pgbouncer=true&connection_limit=5 for Prisma. For Prisma CLI (migrations)
# use the direct (non-pooled) host instead.
DATABASE_URL=

# ============================================
# CASHFREE PAYMENTS (Live & Sandbox)
# ============================================
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox

# ============================================
# RAZORPAY PAYMENTS (Fallback gateway)
# ============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# ORDER ACCESS (HMAC token for order tracking)
# ============================================
ORDER_ACCESS_SECRET=

# ============================================
# DEPLOYMENT
# ============================================
FRONTEND_URL=http://localhost:3000
