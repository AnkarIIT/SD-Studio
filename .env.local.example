# ============================================
# FRONTEND (Vite — http://localhost:3000)
# ============================================
VITE_NOTIFICATION_API_URL=

# ============================================
# SERVER (Express — port 5001)
# Run: npm run server   OR   npm run dev:all
# ============================================
NOTIFICATION_PORT=5001

# ============================================
# DATABASE (Phase 2 — required for orders / newsletter / custom lab)
# ============================================
# MySQL (local dev — run: npx prisma db push)
# Option 1: Docker (easiest - no installation needed)
# Run: docker run --name layerbound-mysql -e MYSQL_ROOT_PASSWORD=rootpassword -e MYSQL_DATABASE=layerbound_db -p 3306:3306 -d mysql:8
DATABASE_URL="mysql://root:rootpassword@localhost:3306/layerbound_db"

# Option 2: Local MySQL installation
# Download from: https://dev.mysql.com/downloads/mysql/
# Install with default settings, set root password during installation

# ============================================
# CASHFREE PAYMENTS (Latest API 2023-08-01)
# ============================================
# Get credentials: https://merchant.cashfree.com/merchant/pg/api-keys
CASHFREE_APP_ID=13004828759f4aa002bfefde4482840031
CASHFREE_SECRET_KEY=your_secret_key_here
FRONTEND_URL=http://localhost:3000
