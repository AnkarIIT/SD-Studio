# ============================================
# FRONTEND (Vite — http://localhost:3000)
# ============================================
# Dev: MUST stay empty — Vite proxies /api → localhost:5001
# Do NOT set http://localhost:3001 (causes ERR_ABORTED on assets/API)
VITE_NOTIFICATION_API_URL=

# ============================================
# NOTIFICATION SERVER (Express — port 5001)
# Run: npm run server   OR   npm run dev:all
# ============================================
NOTIFICATION_PORT=5001

# Gmail (free): 2FA ON → App Password → https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Optional Outlook / custom SMTP (instead of Gmail service)
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587

# SMS — optional Twilio trial; otherwise SMS falls back to email when phone+email provided
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Telegram — free SMS relay to your chat (create bot via @BotFather, get chat id)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ============================================
# DATABASE (Phase 2 — required for orders / newsletter / custom lab)
# ============================================
# SQLite (local dev — run: npx prisma db push)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/layerbound_db"

# Custom lab submissions emailed to you (defaults to EMAIL_USER)
# STORE_OWNER_EMAIL=your-store@gmail.com

# ============================================
# PAYMENTS — Phase 3 (Razorpay + verify queue)
# ============================================
# Razorpay Dashboard → API Keys (test mode for dev)
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your_secret
# Public key for checkout UI (same as KEY_ID):
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx
# Auto-approve manual UPI/bank refs in dev (default: on when NODE_ENV !== production)
# Set false to test admin Payments queue:
# AUTO_VERIFY_PAYMENTS=false
# ORDER_ACCESS_SECRET=change-me-in-production

# ============================================
# ADMIN PANEL (http://localhost:3000/admin)
# ============================================
VITE_ADMIN_PASSWORD=layerbound2026
VITE_ADMIN_API_KEY=layerbound2026
# Server-side (same value for API routes):
ADMIN_API_KEY=layerbound2026