// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// PAYMENTS TABLE
// ============================================
model Payment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  customerId        String
  customerName      String
  customerEmail     String
  customerPhone     String?
  
  // Payment Details
  amount            Float
  currency          String    @default("INR")
  paymentMethod     String    // "upi", "card", "bank_transfer", "cod"
  paymentStatus     String    @default("pending") // "pending", "success", "failed", "refunded"
  paymentReference  String?   // Transaction ID, UTR, etc
  razorpayOrderId   String?
  razorpayPaymentId String?
  
  // Order Info
  itemCount         Int
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?
  expiresAt         DateTime? // For auto-cleanup
  
  // Relationship
  delivery          Delivery?
  
  // Index for queries
  @@index([customerId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([expiresAt])
}

// ============================================
// DELIVERIES TABLE
// ============================================
model Delivery {
  id                String    @id @default(cuid())
  orderId           String    @unique
  paymentId         String    @unique
  
  // Customer Info
  customerName      String
  customerPhone     String?
  
  // Delivery Address
  street            String
  city              String
  state             String
  pincode           String
  
  // Delivery Status
  status            String    @default("pending") // "pending", "shipped", "in_transit", "delivered", "cancelled"
  trackingNumber    String?
  
  // Delivery Dates
  shippedAt         DateTime?
  deliveredAt       DateTime?
  estimatedDelivery DateTime?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime? // For auto-cleanup
  
  // Relationship
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  // Index for queries
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

// ============================================
// AUDIT LOG (Optional - track all changes)
// ============================================
model AuditLog {
  id        String    @id @default(cuid())
  entity    String    // "payment", "delivery"
  entityId  String
  action    String    // "created", "updated", "deleted"
  changes   String?   // JSON string of what changed
  createdAt DateTime  @default(now())
  
  @@index([entityId])
  @@index([createdAt])
}

model Order {
  id                String    @id @default(cuid())
  orderId           String    @unique
  customerId        String
  customerName      String
  customerEmail     String
  customerPhone     String?

  items             String
  subtotal          Float
  tax               Float
  shipping          Float
  discount          Float
  total             Float
  status            String    @default("pending")
  paymentMethod     String?
  paymentReference  String?
  couponCode        String?
  shippingAddress   String

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?

  @@index([customerId])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model CustomLabRequest {
  id        String   @id @default(cuid())
  requestId String   @unique
  name      String
  email     String
  details   String
  fileName  String?
  filePath  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model PaymentVerificationQueue {
  id          String    @id @default(cuid())
  orderId     String
  method      String
  reference   String?
  amount      Float
  status      String    @default("pending")
  notes       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model OrderTimelineEvent {
  id        String   @id @default(cuid())
  orderId   String
  stage     String
  message   String?
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model SiteConfig {
  id        String   @id @default("global")
  data      String
  updatedAt DateTime @updatedAt
}

model ProductOverride {
  productId     String   @id
  price         Float?
  originalPrice Float?
  stock         Int?
  inStock       Boolean?
  hidden        Boolean  @default(false)
  badge         String?
  updatedAt     DateTime @updatedAt
}

model User {
  id         String        @id @default(cuid())
  name       String?
  email      String        @unique
  password   String
  role       String        @default("customer")
  isActive   Boolean       @default(true)
  totpSecret String?       @unique
  totpEnabled Boolean      @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  sessions   UserSession[]

  @@index([email])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
