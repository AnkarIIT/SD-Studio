generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  cancelled
}

enum OrderStatus {
  pending
  pending_payment
  paid
  confirmed
  shipped
  delivered
  cancelled
}

enum DeliveryStatus {
  pending
  shipped
  in_transit
  delivered
  cancelled
}

enum PaymentMethod {
  upi
  card
  bank_transfer
  cod
  razorpay
}

// ============================================
// PAYMENTS TABLE
// ============================================
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  customerId        String
  customerName      String
  customerEmail     String
  customerPhone     String?

  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  paymentMethod     String
  paymentStatus     PaymentStatus @default(pending)
  paymentReference  String?
  razorpayOrderId   String?
  razorpayPaymentId String?

  itemCount         Int

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?
  expiresAt         DateTime?

  order             Order         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  delivery          Delivery?

  @@index([customerId])
  @@index([paymentStatus, createdAt])
  @@index([expiresAt])
}

// ============================================
// DELIVERIES TABLE
// ============================================
model Delivery {
  id                String        @id @default(cuid())
  orderId           String        @unique
  paymentId         String        @unique

  customerName      String
  customerPhone     String?

  street            String
  city              String
  state             String
  pincode           String

  status            DeliveryStatus @default(pending)
  trackingNumber    String?

  shippedAt         DateTime?
  deliveredAt       DateTime?
  estimatedDelivery DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  expiresAt         DateTime?

  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

// ============================================
// AUDIT LOG
// ============================================
model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  changes   String?
  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}

// ============================================
// ORDERS TABLE
// ============================================
model Order {
  id               String      @id @default(cuid())
  orderId          String      @unique
  customerId       String
  customerName     String
  customerEmail    String
  customerPhone    String?

  items            String
  subtotal         Decimal     @db.Decimal(10, 2)
  tax              Decimal     @db.Decimal(10, 2)
  shipping         Decimal     @db.Decimal(10, 2)
  discount         Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(pending)
  paymentMethod    String?
  paymentReference String?
  couponCode       String?
  shippingAddress  String

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  expiresAt        DateTime?

  payments         Payment[]
  deliveries       Delivery[]
  timelineEvents   OrderTimelineEvent[]
  verificationQueue PaymentVerificationQueue[]

  @@index([customerEmail, createdAt])
  @@index([status])
}

// ============================================
// NEWSLETTER
// ============================================
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ============================================
// CUSTOM LAB REQUESTS
// ============================================
model CustomLabRequest {
  id        String   @id @default(cuid())
  requestId String   @unique
  name      String
  email     String
  details   String
  fileName  String?
  filePath  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ============================================
// PAYMENT VERIFICATION QUEUE
// ============================================
model PaymentVerificationQueue {
  id          String   @id @default(cuid())
  orderId     String
  method      String
  reference   String?
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("pending")
  notes       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orderId])
}

// ============================================
// ORDER TIMELINE EVENTS
// ============================================
model OrderTimelineEvent {
  id        String   @id @default(cuid())
  orderId   String
  stage     String
  message   String?
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([orderId, createdAt])
}

// ============================================
// SITE CONFIG
// ============================================
model SiteConfig {
  id        String   @id @default("global")
  data      String
  updatedAt DateTime @updatedAt
}

// ============================================
// PRODUCTS
// ============================================
model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  category         String
  images           Json?
  base_price       Decimal  @db.Decimal(10, 2)
  discounted_price Decimal? @db.Decimal(10, 2)
  is_on_sale       Boolean  @default(false)
  is_new           Boolean  @default(false)
  is_bestseller    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductOverride {
  productId     String   @id
  price         Decimal? @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  stock         Int?
  inStock       Boolean?
  hidden        Boolean  @default(false)
  badge         String?
  updatedAt     DateTime @updatedAt
}

// ============================================
// USERS & SESSIONS
// ============================================
model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  password        String
  role            String        @default("customer")
  isActive        Boolean       @default(true)
  totpSecret      String?       @unique
  totpEnabled     Boolean       @default(false)
  passwordChanged Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        UserSession[]

  @@index([email])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
